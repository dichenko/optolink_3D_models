 width="335" height="32" /></mxCell><mxCell id="74" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=19;fontColor=#4e6875;fontStyle=0;" value="Здесь резисторы, четыре жилы кабеля и провода"><mxGeometry as="geometry" x="604" y="434" width="442" height="28" /></mxCell><mxCell id="75" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=19;fontColor=#4e6875;fontStyle=0;" value="от оптики. Жгут проходит через вырезы рамок."><mxGeometry as="geometry" x="604" y="462" width="422" height="28" /></mxCell><mxCell id="76" parent="1" vertex="1" style="ellipse;fillColor=#173249;strokeColor=none;strokeWidth=1;" value=""><mxGeometry as="geometry" x="565" y="507" width="26" height="26" /></mxCell><mxCell id="77" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=16;fontColor=#ffffff;fontStyle=1;" value="4"><mxGeometry as="geometry" x="573" y="509" width="18" height="25" /></mxCell><mxCell id="78" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=23;fontColor=#173249;fontStyle=1;" value="Нижняя плата только для оптики"><mxGeometry as="geometry" x="604" y="504" width="391" height="32" /></mxCell><mxCell id="79" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=19;fontColor=#4e6875;fontStyle=0;" value="Четыре ножки и четыре провода. Боковые упоры"><mxGeometry as="geometry" x="604" y="540" width="444" height="28" /></mxCell><mxCell id="80" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=19;fontColor=#4e6875;fontStyle=0;" value="задают глубину посадки относительно окон."><mxGeometry as="geometry" x="604" y="568" width="398" height="28" /></mxCell><mxCell id="81" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=19;fontColor=#087b73;fontStyle=1;" value="Ориентир по высоте корпуса: 28–32 мм."><mxGeometry as="geometry" x="568" y="633" width="384" height="28" /></mxCell><mxCell id="82" parent="1" edge="1" style="endArrow=none;startArrow=none;strokeColor=#bac8c8;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="40" y="720" /><mxPoint as="targetPoint" x="1160" y="720" /><Array as="points" /></mxGeometry></mxCell><mxCell id="83" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=15;fontColor=#087b73;fontStyle=1;" value="СБОРКА"><mxGeometry as="geometry" x="42" y="739" width="69" height="24" /></mxCell><mxCell id="84" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=20;fontColor=#173249;fontStyle=1;" value="Спаять пакет на столе → проверить → опустить в стакан → затянуть крышку."><mxGeometry as="geometry" x="144" y="736" width="759" height="29" /></mxCell></root></mxGraphModel></diagram><diagram name="Разъёмный корпус с боковым доступом"><mxGraphModel pageWidth="1200" pageHeight="800" grid="0" page="1" background="#f5f5ef"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" vertex="1" style="fillColor=#f5f5ef;strokeColor=none;strokeWidth=1;" value=""><mxGeometry as="geometry" x="0" y="0" width="1200" height="800" /></mxCell><mxCell id="3" parent="1" vertex="1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;overflow=visible;fontFamily=Segoe UI;fontSize=16;fontColor=#087b73;fontStyle=1;" value="USB-ОПТОЛИНК   /   КОМПОНОВКА 02"><mxGeometry as